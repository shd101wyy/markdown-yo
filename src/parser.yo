// markdown_yo — Main parser orchestrator
//
// Top-level API: normalize → block parse → HTML output.
// SAX-style: block parser calls renderer directly, inline parser uses
// lightweight InlineToken buffer then flushes to renderer.
pragma(Pragma.AllowUnsafe);
{ String } :: import("std/string");
{ ArrayList } :: import("std/collections/array_list");
{ Options, Env, new_env } :: import("./types.yo");
{ HtmlRenderer } :: import("./renderer.yo");
{ BlockState } :: import("./block/state.yo");
{ block_parse } :: import("./block/parser.yo");
{ string_bytes } :: import("./common/utils.yo");

// Convert markdown source to HTML.
// `options` is a read-only borrow, not a `*(Options)`. It is never mutated
// here — it is only handed down to the renderer and the block state, which
// want a pointer for cost. Taking the address is the LIBRARY's business, so it
// happens below, inside a file that is already `Pragma.AllowUnsafe`. The
// address is of a local copy: a `&T` parameter is passed as a copy and has no
// stable address of its own, so `addr_of(options)` is Yo's error E0921.
markdown_to_html :: (fn(src : &String, options : &Options) -> String)({
  (opts_local : Options) = options.clone();
  (opts_ref : *Options) = addr_of(opts_local);

  // 1. Create environment for link references
  (env : Env) = new_env();

  // 2. Get source pointer. The parse reads the source through raw pointers,
  // so it works on one copy of the bytes. This `src_bytes` local keeps them
  // alive: it is declared before `state` and so dropped after it. (When the
  // source needs normalization, `state` owns the normalized copy instead and
  // points the renderer at it.)
  (src_bytes : ArrayList(u8)) = string_bytes(src);
  (src_len : i32) = i32(src_bytes.len());
  (src_ptr : *u8) = match(
    src_bytes.ptr(),
    .Some(p) => p,
    .None => (*u8)("")
  );

  // 3. Create renderer with pre-allocated output buffer
  (renderer : HtmlRenderer) = HtmlRenderer.new(opts_ref, src_ptr, src_len);

  // 4. Create block state (includes normalization + line scan in one pass)
  (state : BlockState) = BlockState.new(&src_bytes, &env, addr_of(renderer), opts_ref);
  block_parse(addr_of(state));

  // 5. Return rendered HTML
  renderer.finish()
});

export(markdown_to_html);
