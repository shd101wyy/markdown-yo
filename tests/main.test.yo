{ assert } :: import("std/assert");
{ String } :: import("std/string");
{ markdown_to_html, default_options } :: import("../src/lib.yo");

test("it works", {
  assert((1 + 1) == 2, "math is broken");
});

// escape_html_buf reserved ~12.5% headroom and wrote escapes straight into
// the buffer, but `"` escapes to 6 bytes: 5000 quotes wrote past capacity
// (issues/escape-dense-text-overflows-the-output-buffer.md).
test("escape-dense text grows the output instead of overflowing it", {
  (mut(src) : String) = String.new();
  (mut(i) : usize) = usize(0);
  while(i < usize(5000), {
    src.push_str("\"");
    i = (i + usize(1));
  });
  html := markdown_to_html(&src, default_options());
  assert(html.len() == usize(30008), `expected <p> + 5000 &quot; + </p>\n, got ${html.len().to_string()} bytes`);
});

// normalize_link percent-decodes a domain into a fresh, exactly-sized buffer,
// and punycode_encode decoded it as UTF-8 reading p+1..p+3 unchecked: `%F0`
// (a truncated lead) or a trailing `%80` (a bare continuation byte, reached
// once the domain holds a `%C0`+ escape) read up to 3 bytes past the
// allocation and emitted them into the href.
// Each invalid byte now decodes to U+FFFD. The expected labels pin today's
// domain re-encoding, which punycodes literal escapes where markdown-it keeps
// them (issues/literal-percent-escapes-in-a-domain-are-punycoded.md).
test("punycode of a truncated percent-decoded UTF-8 domain stays in bounds", {
  (truncated : String) = String.from("[l](http://a%F0/)\n");
  html := markdown_to_html(&truncated, default_options());
  assert(html == String.from("<p><a href=\"http://xn--a-q10i/\">l</a></p>\n"), `%F0 domain: got ${html}`);

  (continuation : String) = String.from("[l](http://a%C3%A3%80/)\n");
  html2 := markdown_to_html(&continuation, default_options());
  assert(html2 == String.from("<p><a href=\"http://xn--a-yfa2307q/\">l</a></p>\n"), `%C3%A3%80 domain: got ${html2}`);

  (valid : String) = String.from("[l](http://a%C3%A3/)\n");
  html3 := markdown_to_html(&valid, default_options());
  assert(html3 == String.from("<p><a href=\"http://xn--a-yfa/\">l</a></p>\n"), `valid multibyte domain: got ${html3}`);
});
